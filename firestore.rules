rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().data.role == 'admin';
    }

    function isFighter() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().data.role == 'fighter';
    }

    function fighterOwnsResource() {
      return resource.data.keys().hasAll(['fighterId'])
          && resource.data.fighterId == request.auth.uid;
    }

    function fighterOwnsRequestResource() {
      return request.resource.data.keys().hasAll(['fighterId'])
          && request.resource.data.fighterId == request.auth.uid;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow create, update, delete: if isAdmin();

      match /deviceTokens/{tokenId} {
        allow read: if isAdmin() || isSelf(userId);
        allow create, update, delete: if isSelf(userId);
      }
    }

    // Contacts: fighter-owned by fighterId
    match /contacts/{docId} {
      allow read: if isAdmin()
          || (isFighter() && (docId == '_meta' || fighterOwnsResource()));

      allow create: if isAdmin()
          || (isFighter() && fighterOwnsRequestResource());

      allow update, delete: if isAdmin()
          || (isFighter() && fighterOwnsResource());
    }

    // Locations: fighters are view-only
    match /locations/{docId} {
      allow read: if isAdmin() || isFighter();
      allow write: if isAdmin();
    }

    // Schedules / Whereabouts: fighter-owned by fighterId
    match /schedules/{docId} {
      allow read: if isAdmin()
          || (isFighter() && (docId == '_meta' || fighterOwnsResource()));

      allow create: if isAdmin()
          || (isFighter() && fighterOwnsRequestResource());

      allow update, delete: if isAdmin()
          || (isFighter() && fighterOwnsResource());
    }

    match /checkins/{docId} {
      allow read, write: if isAdmin();
    }

    match /notifications/{docId} {
      // Admin messages + admin monitoring
      allow read, update, delete: if isAdmin();

      // Admin can create notification requests (e.g. admin_message)
      allow create: if isAdmin();

      // Fighter can create certain requests to admin (future modules)
      allow create: if isFighter()
          && request.resource.data.sourceUid == request.auth.uid
          && request.resource.data.targetRole == 'admin'
          && (request.resource.data.type in [
            'schedule_change_submission',
            'schedule_update'
          ]);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
