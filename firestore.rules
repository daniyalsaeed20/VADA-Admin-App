rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().data.role == 'admin';
    }

    function isFighter() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().data.role == 'fighter';
    }

    function fighterOwnsResource() {
      return resource.data.keys().hasAll(['fighterId'])
          && resource.data.fighterId == request.auth.uid;
    }

    function fighterOwnsRequestResource() {
      return request.resource.data.keys().hasAll(['fighterId'])
          && request.resource.data.fighterId == request.auth.uid;
    }

    function validScheduleChangeRequestType() {
      return request.resource.data.requestType in [
        'new_location',
        'time_change',
        'schedule_update',
      ];
    }

    function linkedSchedule(scheduleId) {
      return get(/databases/$(database)/documents/schedules/$(scheduleId));
    }

    function scheduleExistsAndOwned(scheduleId) {
      return scheduleId is string
          && scheduleId.size() > 0
          && exists(/databases/$(database)/documents/schedules/$(scheduleId))
          && linkedSchedule(scheduleId).data.fighterId == request.auth.uid;
    }

    function scheduleIsUpcoming(scheduleId) {
      return scheduleExistsAndOwned(scheduleId)
          && linkedSchedule(scheduleId).data.endAt > request.time;
    }

    function requestHasScheduleId() {
      return request.resource.data.keys().hasAll(['scheduleId'])
          && request.resource.data.scheduleId is string
          && request.resource.data.scheduleId.size() > 0;
    }

    function requestedChanges() {
      return request.resource.data.requestedChanges;
    }

    function requestedStartAtIsUpcoming() {
      return !('startAt' in requestedChanges())
          || requestedChanges().startAt > request.time;
    }

    function requestedEndAtIsUpcoming() {
      return !('endAt' in requestedChanges())
          || requestedChanges().endAt > request.time;
    }

    function hasLocationChangeFromSchedule(scheduleId) {
      let schedule = linkedSchedule(scheduleId).data;
      let changes = requestedChanges();
      let locationIdChanged = 'locationId' in changes
          && changes.locationId is string
          && changes.locationId.size() > 0
          && ('locationId' in schedule)
          && schedule.locationId is string
          && changes.locationId != schedule.locationId;
      let proposedDiffers = 'proposedLocationText' in changes
          && changes.proposedLocationText is string
          && changes.proposedLocationText.size() > 0
          && (
            !('locationName' in schedule)
            || !(schedule.locationName is string)
            || changes.proposedLocationText != schedule.locationName
          );
      let locationNameChanged = 'locationName' in changes
          && changes.locationName is string
          && changes.locationName.size() > 0
          && ('locationName' in schedule)
          && schedule.locationName is string
          && changes.locationName != schedule.locationName;
      return locationIdChanged || proposedDiffers || locationNameChanged;
    }

    function hasTimeChangeFields() {
      let changes = requestedChanges();
      return ('startAt' in changes)
          || ('endAt' in changes)
          || ('date' in changes)
          || ('startTime' in changes)
          || ('endTime' in changes);
    }

    function validChangesForRequestType(scheduleId) {
      return request.resource.data.requestType == 'new_location'
          ? hasLocationChangeFromSchedule(scheduleId)
          : request.resource.data.requestType == 'time_change'
          ? hasTimeChangeFields()
          : request.resource.data.requestType == 'schedule_update'
          ? (hasTimeChangeFields() || hasLocationChangeFromSchedule(scheduleId))
          : false;
    }

    // Duplicate pending requests per schedule are blocked in the mobile app
    // before create. Firestore rules cannot query sibling documents on create.
    function fighterCreatesScheduleChangeRequest() {
      let scheduleId = request.resource.data.scheduleId;
      return isFighter()
          && fighterOwnsRequestResource()
          && request.resource.data.status == 'pending'
          && validScheduleChangeRequestType()
          && requestHasScheduleId()
          && scheduleIsUpcoming(scheduleId)
          && request.resource.data.notes is string
          && request.resource.data.notes.size() > 0
          && request.resource.data.requestedChanges is map
          && requestedChanges().size() > 0
          && validChangesForRequestType(scheduleId)
          && requestedStartAtIsUpcoming()
          && requestedEndAtIsUpcoming();
    }

    match /users/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow create, update, delete: if isAdmin();

      match /deviceTokens/{tokenId} {
        allow read: if isAdmin() || isSelf(userId);
        allow create, update, delete: if isSelf(userId);
      }

      match /notificationReads/{notificationId} {
        allow read, create, update, delete: if isSelf(userId);
      }
    }

    match /contacts/{docId} {
      allow read: if isAdmin()
          || (isFighter() && (docId == '_meta' || fighterOwnsResource()));

      allow create: if isAdmin()
          || (isFighter() && fighterOwnsRequestResource());

      allow update, delete: if isAdmin()
          || (isFighter() && fighterOwnsResource());
    }

    match /locations/{docId} {
      allow read: if isAdmin() || isFighter();
      allow write: if isAdmin();
    }

    match /schedules/{docId} {
      allow read: if isAdmin()
          || (isFighter() && (docId == '_meta' || fighterOwnsResource()));

      allow create: if isAdmin()
          || (isFighter() && fighterOwnsRequestResource());

      allow update, delete: if isAdmin()
          || (isFighter() && fighterOwnsResource());
    }

    match /checkins/{docId} {
      allow read: if isAdmin()
          || (isFighter() && fighterOwnsResource());

      allow create: if isAdmin()
          || (isFighter() && fighterOwnsRequestResource());

      allow update, delete: if isAdmin();
    }

    match /scheduleChangeRequests/{docId} {
      allow read: if isAdmin()
          || (isFighter() && fighterOwnsResource());

      allow create: if isAdmin()
          || fighterCreatesScheduleChangeRequest();

      allow update, delete: if isAdmin();
    }

    match /notifications/{docId} {
      allow read: if isAdmin()
          || (isFighter()
              && (resource.data.target == 'broadcast'
                  || resource.data.targetUserId == request.auth.uid));

      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}